{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tyrian-tauri-scala",
  "version": "0.1.0",
  "identifier": "com.w47s0n.tyrian-tauri-scala",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:9876",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Analytics Dashboard",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
